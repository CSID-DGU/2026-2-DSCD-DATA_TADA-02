    "/api/v1/areas/{area_code}/analysis": {
      "get": {
        "tags": [
          "analysis"
        ],
        "summary": "Detail",
        "operationId": "detail_api_v1_areas__area_code__analysis_get",
        "parameters": [
          {
            "name": "area_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Area Code"
            }
          },
          {
            "name": "quarter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^20\\d{2}Q[1-4]$",
              "default": "2026Q2",
              "title": "Quarter"
            }
          }
        ],
        "responses": {
          "200": {
