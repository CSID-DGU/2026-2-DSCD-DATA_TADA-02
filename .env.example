APP_ENV=development
DATABASE_URL=sqlite:///./tmp/service.db
DATA_MODE=demo
# Set DATA_MODE=supabase to read the published statistics and presentation examples.
# SUPABASE_DATABASE_URL=postgresql+psycopg://USER.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# SUPABASE_SSLROOTCERT=data/certificates/supabase-ca.crt
SEED_ON_START=true
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=40
LLM_MAX_CONCURRENT=2
LLM_CACHE_TTL_SECONDS=86400
SERVICE_ACCESS_TOKEN=
# DATABASE_URL is the writable explanation cache in Supabase mode.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/data_tada?charset=utf8mb4
# Never use a VITE_ variable for credentials.
